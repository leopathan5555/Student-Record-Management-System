<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.MainController">
            

  
    <top>
        <Label style="-fx-font-size: 20; -fx-padding: 10;" text="Student Record Management System" />
    </top>

   
    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colId" prefWidth="100.0" text="ID" />
                <TableColumn fx:id="colName" prefWidth="150.0" text="Name" />
                <TableColumn fx:id="colDept" prefWidth="120.0" text="Department" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="colCgpa" prefWidth="123.3333740234375" text="CGPA" />
            </columns>
        </TableView>
    </center>

   
    <bottom>
        <HBox alignment="center" spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <TextField fx:id="idField" prefHeight="22.0" prefWidth="80.0" promptText="ID">
            <font>
               <Font name="Baskerville Old Face" size="11.0" />
            </font></TextField>
            <TextField fx:id="nameField" prefHeight="22.0" prefWidth="80.0" promptText="Name">
            <font>
               <Font name="Baskerville Old Face" size="11.0" />
            </font></TextField>
            <TextField fx:id="deptField" prefHeight="22.0" prefWidth="80.0" promptText="Department">
            <font>
               <Font name="Baskerville Old Face" size="11.0" />
            </font></TextField>
            <TextField fx:id="emailField" prefHeight="22.0" prefWidth="80.0" promptText="Email">
            <font>
               <Font name="Baskerville Old Face" size="11.0" />
            </font></TextField>
            <TextField fx:id="cgpaField" prefWidth="81.0" promptText="CGPA">
            <font>
               <Font name="Baskerville Old Face" size="11.0" />
            </font></TextField>

            <Button onAction="#addStudent" text="Add" />
            <Button onAction="#updateStudent" text="Update" />
            <Button onAction="#deleteStudent" text="Delete" />
            <Button onAction="#searchStudent" text="Search" />
        </HBox>
    </bottom>

</BorderPane>
